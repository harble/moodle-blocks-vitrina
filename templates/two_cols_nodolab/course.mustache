{{!
    @template block_vitrina/two_cols_nodolab/course

    This template renders the template content area for a resource.

    Example context (json):
    {
        "id": 1,
        "fullname": "Course name",
        "shortname": "Course short name",
        "summary": "Course summary",
        "category": "Category name",
        "imagepath": "http://example.com/image.jpg",
        "active": true,
        "premium": true,
        "fee": true,
        "formatedcost": "$ 100.00",
        "baseurl": "http://example.com",
        "hascart": false,
        "hasrating": false,
        "rating": {
            "percent": 100
        },
        "opendetailstarget": "_blank"
    }
}}

<div class="panel panel-default coursebox coursecategory-{{category}} state-{{#active}}active{{/active}}{{^active}}waiting{{/active}} {{#premium}}type-premium{{/premium}}{{#completed}} coursecompleted{{/completed}}" data-vitrina-detailurl="{{#hascourseurl}}{{courseurl}}{{/hascourseurl}}{{^hascourseurl}}{{{baseurl}}}/blocks/vitrina/detail.php?id={{{id}}}&direct=1{{/hascourseurl}}" data-vitrina-detailtarget="{{opendetailstarget}}">
    <div class="panel-body clearfix">
        <a class="courseimage-link" title="{{summarytitle}}" href="{{#hascourseurl}}{{courseurl}}{{/hascourseurl}}{{^hascourseurl}}{{{baseurl}}}/blocks/vitrina/detail.php?id={{{id}}}&direct=1{{/hascourseurl}}" target="{{opendetailstarget}}">
            <div class="courseimage" {{#imagepath}}style="background-image: url({{imagepath}});"{{/imagepath}}></div>
            {{#hasmeetingstatus}}
            <div class="meeting-status-wrapper">
                <div class="meeting-status-badge meeting-status-{{meetingstatus}}" title="{{meetingstatustitle}}">
                    <svg class="meeting-status-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>
                    </svg>
                    <span>{{meetingstatustext}}</span>
                </div>
                {{#hasmeetingtimeinfo}}
                <div class="meeting-time-info">
                    {{meetingtimeinfo}}
                </div>
                {{/hasmeetingtimeinfo}}
            </div>
            {{/hasmeetingstatus}}
        </a>
        <h3 class="course-name" title="{{{fullname}}}">
            {{{fullname}}}
        </h3>
        <div class="coursesummary" style="display: none;">
            {{{summary}}}
        </div>
        {{#fee}}
            <div class="coursefee">
                <div class="feeinfo">
                    {{#str}} feeinfoinlist, block_vitrina, {{formatedcost}} {{/str}}
                </div>
                {{#hascart}}
                    {{> block_vitrina/cartbutton}}
                {{/hascart}}
            </div>
        {{/fee}}
    </div>
    <div class="panel-foot clearfix">
        {{#hasprogress}}
            <div class="course-progress">
                <div class="course-progress-bar" style="width: {{progress}}%;"></div>
                <span>{{#str}}completepercent, block_vitrina, {{progress}}{{/str}}</span>
            </div>
        {{/hasprogress}}
        <div class="course-extra-row">
            <div class="course-type-left">
                {{#hascoursetype}}
                    <span class="course-type">
                        {{{coursetypeiconhtml}}}
                        <span class="course-type-label">{{coursetype}}</span>
                    </span>
                {{/hascoursetype}}
            </div>
            <div class="course-rating-center">
                {{#hasrating}}
                    {{#rating}}
                    <div class="vitrina-ranking-stars" title="{{title}}">
                        <div class="vitrina-ranking-stars-bar" style="width: {{percent}}%;"></div>
                    </div>
                    {{/rating}}
                {{/hasrating}}
            </div>
            <!--            <div class="course-enrolled-right">
                {{#enrolled}}
                    <a href="{{{baseurl}}}/course/view.php?id={{{id}}}" target="_blank" rel="noopener noreferrer" class="course-enrolled-label-link">{{#str}} enrolledshort, block_vitrina {{/str}}</a>
                {{/enrolled}}
            </div>-->
        </div>
    </div>
    {{^active}}
        <div class="waiting-label">{{#str}}waiting, block_vitrina{{/str}}</div>
    {{/active}}
    {{#hascourseactions}}
    <div class="course-actions-menu">
        <button type="button" class="course-actions-toggle" aria-haspopup="true" aria-expanded="false" title="{{#str}}coursemenu, block_vitrina{{/str}}">
            <svg class="course-actions-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="5" r="2" stroke="currentColor" stroke-width="1.2"></circle>
                <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.2"></circle>
                <circle cx="12" cy="19" r="2" stroke="currentColor" stroke-width="1.2"></circle>
            </svg>
        </button>
        <div class="course-actions-dropdown" role="menu">
            {{#enrolled}}
            {{#canunenrol}}
            <a class="course-actions-item" role="menuitem" href="{{{unenrolurl}}}">{{#str}}unenrolcourse, block_vitrina{{/str}}</a>
            {{/canunenrol}}
            {{^canunenrol}}
            <a class="course-actions-item" role="menuitem" href="{{#hascourseurl}}{{courseurl}}{{/hascourseurl}}{{^hascourseurl}}{{{baseurl}}}/course/view.php?id={{{id}}}{{/hascourseurl}}" target="{{opendetailstarget}}">{{#str}}gotocourse, block_vitrina{{/str}}</a>
            {{/canunenrol}}
            {{/enrolled}}
            {{^enrolled}}
            {{#canenrol}}
            <a class="course-actions-item" role="menuitem" href="{{{enrolurl}}}">{{#str}}enroll, block_vitrina{{/str}}</a>
            {{/canenrol}}
            {{^canenrol}}
            <span class="course-actions-item disabled" role="menuitem" aria-disabled="true">{{#str}}notenrollable, block_vitrina{{/str}}</span>
            {{/canenrol}}
            {{/enrolled}}
            {{#canfavorite}}
            <a class="course-actions-item course-actions-favorite{{#isfavorite}} is-favorite{{/isfavorite}}" role="menuitem" href="#" data-courseid="{{id}}" data-isfavorite="{{#isfavorite}}1{{/isfavorite}}{{^isfavorite}}0{{/isfavorite}}">
                <span class="course-favorite-label favorite-off">{{#str}}favoritecourse, block_vitrina{{/str}}</span>
                <span class="course-favorite-label favorite-on">{{#str}}unfavoritecourse, block_vitrina{{/str}}</span>
            </a>
            {{/canfavorite}}
            <a class="course-actions-item course-actions-copylink" role="menuitem" href="#" data-courselink="{{#hascourseurl}}{{courseurl}}{{/hascourseurl}}{{^hascourseurl}}{{{baseurl}}}/blocks/vitrina/detail.php?id={{{id}}}&direct=1{{/hascourseurl}}">
                <span class="course-copylink-label">{{#str}}copylink, block_vitrina{{/str}}</span>
            </a>
            {{#hascoursedetail}}
            <a class="course-actions-item" role="menuitem" href="{{{baseurl}}}/blocks/vitrina/detail.php?id={{{id}}}" target="{{opendetailstarget}}">{{#str}}coursedetail, block_vitrina{{/str}}</a>
            {{/hascoursedetail}}
        </div>
    </div>
    {{/hascourseactions}}
</div>